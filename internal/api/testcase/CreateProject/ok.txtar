CreateProjectの正常系。プロジェクトを作成し、レスポンスとデータベースの状態を検証する。

-- setup.sql --
insert into users (id, email, hashed_password, created_at, updated_at) values
('USER-000000000000000000001', 'user1@dummy.invalid', 'password', '2025-01-01 00:00:01', '2025-01-01 00:00:01');

-- request --
POST /projects
Authorization: Bearer ${TOKEN}
Content-Type: application/json

{"name": "プロジェクト1", "color": "blue"}

-- response.golden --
200

{
  "id": "GENERATED-ID-0000000000001",
  "name": "プロジェクト1",
  "color": "blue",
  "is_archived": false,
  "created_at": "2025-01-01T00:10:00+09:00",
  "updated_at": "2025-01-01T00:10:00+09:00"
}

-- db.golden --
> select id, user_id, name, color, is_archived, created_at, updated_at from projects order by id;
[
  {
    "id": "GENERATED-ID-0000000000001",
    "user_id": "USER-000000000000000000001",
    "name": "プロジェクト1",
    "color": "blue",
    "is_archived": 0,
    "created_at": "2025-01-01T00:10:00+09:00",
    "updated_at": "2025-01-01T00:10:00+09:00"
  }
]
